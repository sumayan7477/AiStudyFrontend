# Copy to .env (or .env.local) and adjust for your machine.
# Only VITE_-prefixed variables are exposed to the browser bundle,
# so never put secrets (API keys, passwords, JWT signing keys) in this file.

# Base URL of the AiStudyAssistantApi backend, including the /api prefix.
# Local development: run the API's "https" launch profile and trust the dev
# certificate once with:  dotnet dev-certs https --trust
VITE_API_BASE_URL=https://localhost:7075/api
